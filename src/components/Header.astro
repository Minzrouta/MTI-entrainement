---
const path = Astro.url.pathname;
const current = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/">MTI<span class="dot">·</span>Training</a>
    <nav class="site-nav" aria-label="Navigation">
      <a href="/" aria-current={current('/')}>
        <span data-l="fr">Aujourd'hui</span><span data-l="en">Today</span>
      </a>
      <a href="/sujets" aria-current={current('/sujets')}>
        <span data-l="fr">Toutes les fiches</span><span data-l="en">All topics</span>
      </a>
      <a href="/entrainement" aria-current={current('/entrainement')}>
        <span data-l="fr">Entraînement</span><span data-l="en">Practice</span>
      </a>
    </nav>
    <div class="lang-switch" role="group" aria-label="Langue / Language">
      <button data-set-lang="fr" type="button">FR</button>
      <button data-set-lang="en" type="button">EN</button>
    </div>
  </div>
</header>
